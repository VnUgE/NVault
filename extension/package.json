    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "postcss": "^8.5.26",
    "sass": "^1.103.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11",
    "web-ext": "^10.6.0"
  },
